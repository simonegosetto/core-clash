  "description": "",
  "homepage": "https://github.com/simonegosetto/rpg-hw-wars#readme",
  "bugs": {
    "url": "https://github.com/simonegosetto/rpg-hw-wars/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonegosetto/rpg-hw-wars.git"
